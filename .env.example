# AEO Orchestrator Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Required Configuration
# ============================================

# Anthropic API key for Claude LLM
ANTHROPIC_API_KEY=your-anthropic-api-key

# JWT secret for authentication (use a long random string in production)
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# ============================================
# Database Configuration
# ============================================

# PostgreSQL with asyncpg driver
DATABASE_URL=postgresql+asyncpg://aeo:aeo_password@localhost:5432/aeo

# Synchronous URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://aeo:aeo_password@localhost:5432/aeo

# ============================================
# Redis Configuration
# ============================================

# Redis URL for job queue and rate limiting
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# ============================================
# Application Settings
# ============================================

# Environment: development, staging, production
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Authentication Settings
# ============================================

# JWT algorithm
JWT_ALGORITHM=HS256

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Rate Limiting
# ============================================

# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true

# Default requests per minute per organization
DEFAULT_RATE_LIMIT_RPM=60

# ============================================
# Worker Configuration
# ============================================

# Number of concurrent background jobs
WORKER_CONCURRENCY=4

# Hours between automatic monitoring runs
MONITORING_INTERVAL_HOURS=4

# Maximum job execution time in seconds
JOB_TIMEOUT_SECONDS=600

# Maximum retry attempts for failed jobs
JOB_MAX_RETRIES=3

# ============================================
# Optional: External AI APIs
# ============================================

# OpenAI API key (for GPT-based answer engine queries)
# OPENAI_API_KEY=your-openai-api-key

# Perplexity API key (for Perplexity answer engine)
# PERPLEXITY_API_KEY=your-perplexity-api-key

# Google API key (for Google AI/Gemini)
# GOOGLE_API_KEY=your-google-api-key
