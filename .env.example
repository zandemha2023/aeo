# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aeo
DATABASE_SYNC_URL=postgresql://user:password@localhost:5432/aeo

# AI Engine APIs (for querying external AI services)
OPENAI_API_KEY=your_openai_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key
GOOGLE_API_KEY=your_google_api_key

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Worker settings
WORKER_CONCURRENCY=4
MONITORING_INTERVAL_HOURS=4
